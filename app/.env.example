# App
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=8501
API_URL=http://127.0.0.1:8000

# Storage
STORAGE_DIR=storage
MAX_UPLOAD_SIZE_MB=250
MAX_DURATION_SECONDS=1800

# Device: auto, cuda or cpu (auto uses the GPU if there is one)
DEVICE=auto
COMPUTE_TYPE=auto

# Hugging Face token, needed for pyannote diarization
# HF_TOKEN=

# NeMo diarization (optional)
# NEMO_PYTHON=/path/to/envs/cs698b_nemo/bin/python
# NEMO_MSDD_CHECKPOINT=/path/to/diar_msdd_telephonic.nemo

# Database path (optional)
# APP_DB_PATH=storage/app.db
